# Server only. Copy to .env.local; never commit filled credentials.
DATABASE_URL=postgres://atlas:change-me@127.0.0.1:5432/atlas
ATLAS_SCHEMA=atlas
DATABASE_POOL_MAX=10
# Set require for managed PostgreSQL TLS; certificates are always verified.
# DATABASE_SSL=require

# Site to monitor and canonical origin of this dashboard (not the same setting).
ATLAS_SITE_URL=https://example.com
ATLAS_APP_URL=http://127.0.0.1:3000
# ATLAS_REPOSITORY=owner/repository
# ATLAS_REPOSITORY_PATH=/absolute/path/to/local/checkout

# password | header | open. open works only for loopback development, never production.
ATLAS_AUTH=password
# At least 12 characters; choose a unique high-entropy password.
ATLAS_PASSWORD=
# Generate independently: openssl rand -hex 32
ATLAS_SESSION_SECRET=
ATLAS_SESSION_SECONDS=28800

# Optional scheduler credential, at least 32 random characters. Collection only.
# ATLAS_COLLECTOR_TOKEN=

# Header mode only: proxy overwrites these headers after authenticating the user.
# ATLAS_USER_HEADER=x-atlas-user
# ATLAS_PROXY_SECRET=

# Explicit synthetic demo. Uses its own reserved schema, never ATLAS_SCHEMA.
# ATLAS_DEMO=true
# ATLAS_DEMO_SCHEMA=atlas_demo_preview
# With the same values in your environment: pnpm seed
